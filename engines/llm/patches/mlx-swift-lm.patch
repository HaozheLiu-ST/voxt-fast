+
+private final class GatedDeltaRowsKernelManager: Sendable {
+    static let shared = GatedDeltaRowsKernelManager()
+
+    let kernel: MLXFast.MLXFastKernel?
+    let maskedKernel: MLXFast.MLXFastKernel?
+
+    private init() {
+        kernel = makeGatedDeltaRowsKernel(hasMask: false, rows: gatedDeltaRows)
+        maskedKernel = makeGatedDeltaRowsKernel(hasMask: true, rows: gatedDeltaRows)
+    }
+}
+
+/// Multi-row variant of ``gatedDeltaKernel``; falls back to it when `Dv` does not split
+/// into whole groups of rows.
+func gatedDeltaKernelRows(
+    q: MLXArray,
+    k: MLXArray,
+    v: MLXArray,
+    g: MLXArray,
+    beta: MLXArray,
+    state: MLXArray,
+    mask: MLXArray? = nil
+) -> (MLXArray, MLXArray) {
+    let rows = gatedDeltaRows
+    let B = k.dim(0)
+    let T = k.dim(1)
+    let Hk = k.dim(2)
+    let Dk = k.dim(3)
+    let Hv = v.dim(2)
+    let Dv = v.dim(3)
+    let inputType = q.dtype
+    let stateType = state.dtype
+
+    // Rows must tile Dv into whole SIMD-groups of 4 (threadgroup y = 4).
+    guard Dv % (4 * rows) == 0 else {
+        return gatedDeltaKernel(q: q, k: k, v: v, g: g, beta: beta, state: state, mask: mask)
+    }
+
+    let manager = GatedDeltaRowsKernelManager.shared
+    let selected: MLXFast.MLXFastKernel?
+    var inputs: [MLXArray] = [q, k, v, g, beta, state, MLXArray(T)]
+    if let mask {
+        selected = manager.maskedKernel
+        inputs.append(mask)
+    } else {
+        selected = manager.kernel
+    }
+    guard let kernel = selected else {
+        return gatedDeltaKernel(q: q, k: k, v: v, g: g, beta: beta, state: state, mask: mask)
+    }
+
+    let outputs = kernel(
+        inputs,
+        template: [
+            ("InT", inputType),
+            ("StT", stateType),
+            ("Dk", Dk),
+            ("Dv", Dv),
+            ("Hk", Hk),
+            ("Hv", Hv),
+            ("ROWS", rows),
+        ],
+        grid: (32, Dv / rows, B * Hv),
+        threadGroup: (32, 4, 1),
+        outputShapes: [[B, T, Hv, Dv], state.shape],
+        outputDTypes: [inputType, stateType]
+    )
+    return (outputs[0], outputs[1])
+}
