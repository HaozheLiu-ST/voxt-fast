+/// Delta-rule kernel that keeps `R` value rows per SIMD-group.
+///
+/// The one-row kernel launches `B*Hv*Dv` SIMD-groups, each of which reads one
+/// 128-float state row (512 B) and then does two 32-lane reductions per step. At
+/// T=1 that is ~4096 SIMD-groups against ~80 resident ones: the kernel is DRAM
+/// latency bound (93 GB/s of the machine's 253 GB/s) rather than bandwidth or
+/// ALU bound. Handling `R` rows per SIMD-group multiplies the bytes in flight per
+/// group by `R`, divides the number of waves by `R`, shares the q/k/g/beta loads
+/// across the `R` rows and gives the two reductions `R` independent chains.
+///
+/// The arithmetic is unchanged and in the same order: per row, the same
+/// `state*g`, the same Kahan-compensated `kv_mem` over the same 4 elements per
+/// lane followed by `simd_sum` over the same 32 lanes, then the same update and
+/// output reduction. Results are bit-identical to the one-row kernel.
+private func makeGatedDeltaRowsKernel(hasMask: Bool, rows: Int) -> MLXFast.MLXFastKernel? {
+    let maskSource = hasMask ? "mask[b_idx * T + t]" : "true"
+
+    let source = """
+            auto n = thread_position_in_grid.z;
+            auto b_idx = n / Hv;
+            auto hv_idx = n % Hv;
+            auto hk_idx = hv_idx / (Hv / Hk);
+            constexpr int n_per_t = Dk / 32;
+            constexpr int R = ROWS;
+
+            // q, k: [B, T, Hk, Dk]
+            auto q_ = q + b_idx * T * Hk * Dk + hk_idx * Dk;
+            auto k_ = k + b_idx * T * Hk * Dk + hk_idx * Dk;
+
+            // v, y: [B, T, Hv, Dv]; this SIMD-group owns R contiguous dv rows.
+            auto dv_base = thread_position_in_grid.y * R;
+            auto v_ = v + b_idx * T * Hv * Dv + hv_idx * Dv + dv_base;
+            auto y_ = y + b_idx * T * Hv * Dv + hv_idx * Dv + dv_base;
+
+            auto dk_idx = thread_position_in_threadgroup.x;
+
+            // g, beta: [B, T, Hv]
+            auto g_ = g + b_idx * T * Hv;
+            auto beta_ = beta + b_idx * T * Hv;
+
+            // state_in, state_out: [B, Hv, Dv, Dk]
