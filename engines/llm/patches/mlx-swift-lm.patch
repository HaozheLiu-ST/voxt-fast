+/// Attention whose query block is padded with `padQueries` zero rows before the SDPA call.
+///
+/// The padding exists so that a forward over the *new* rows of a prompt can keep the exact
+/// geometry (query length M, and therefore the tiling and rounding) of the longer forward that
+/// computed the cached rows, while only the real rows are computed. Every row's attention output
+/// depends only on its own query and the key set, so the real rows are bit-identical to the same
+/// rows of the unpadded longer forward; the padding rows' outputs are dropped.
+///
+/// - Parameter causalOffset: the position of the first real query row (the cache length before
+///   the update). The causal mask is rebuilt for `padQueries + L` rows.
+public func attentionWithCacheUpdatePadded(
+    queries: MLXArray,
+    keys: MLXArray,
+    values: MLXArray,
+    cache: KVCache?,
+    scale: Float,
+    padQueries: Int,
+    causalOffset: Int?,
+    padKeys: Int = 0
+) -> MLXArray {
+    let L = queries.dim(2)
+    guard padQueries > 0, L > 0 else {
+        return attentionWithCacheUpdate(
+            queries: queries, keys: keys, values: values, cache: cache, scale: scale, mask: .none)
+    }
+    var cachedKeys: MLXArray
+    var cachedValues: MLXArray
+    if let cache {
+        (cachedKeys, cachedValues) = cache.update(keys: keys, values: values)
+    } else {
+        cachedKeys = keys
+        cachedValues = values
+    }
+    let offset = causalOffset ?? (cachedKeys.dim(2) - L)
+    if padKeys > 0 {
+        // Pad the key block too: the unfused fallback's softmax / P@V reductions are tiled by
+        // the key length, so matching it is part of matching the geometry.
+        let pad = MLXArray.zeros(
+            [cachedKeys.dim(0), cachedKeys.dim(1), padKeys, cachedKeys.dim(3)],
+            dtype: cachedKeys.dtype)
+        cachedKeys = concatenated([cachedKeys, pad], axis: 2)
+        let padV = MLXArray.zeros(
+            [cachedValues.dim(0), cachedValues.dim(1), padKeys, cachedValues.dim(3)],
+            dtype: cachedValues.dtype)
+        cachedValues = concatenated([cachedValues, padV], axis: 2)
+    }
+    let pad = MLXArray.zeros(
+        [queries.dim(0), queries.dim(1), padQueries, queries.dim(3)], dtype: queries.dtype)
+    let paddedQueries = concatenated([pad, queries], axis: 2)
+    // Causal mask for `padQueries + L` query rows over the keys actually present: row i sees
+    // keys 0...offset+i (clipped to the cache length).
+    let kLen = cachedKeys.dim(2)
+    // The real rows sit at positions padQueries...padQueries+L-1 and stand for positions
+    // offset...offset+L-1, so row i sees keys 0...offset+i-padQueries.
+    let rows = MLXArray(0 ..< (padQueries + L)).reshaped(-1, 1)
+    let cols = MLXArray(0 ..< kLen).reshaped(1, -1)
+    let limits = MLX.maximum(rows + (offset - padQueries), MLXArray(0))
+    let maskArray = MLX.where(
+        cols .<= limits, MLXArray(0, dtype: queries.dtype),
+        MLXArray(-Float.infinity, dtype: queries.dtype))
+    let mask = MLXFast.ScaledDotProductAttentionMaskMode.array(maskArray)
+    let out = MLXFast.scaledDotProductAttention(
+        queries: paddedQueries, keys: cachedKeys, values: cachedValues, scale: scale, mask: mask)
+    return out[0..., 0..., padQueries..., 0...]
